*.WordPress.*.xml

# Logs de desarrollo
*.log
npm-debug.log*

# Variables de entorno / secretos
.env
.env.*
!.env.example

# Configuración local de Claude Code (específica de esta máquina)
.claude/settings.local.json

# Sistema operativo / editor
.DS_Store
Thumbs.db
