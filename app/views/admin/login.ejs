<%- include('partials/head', { title: 'Iniciar sesión' }) %>
<div class="auth-screen">
  <div class="auth-card">
    <div class="auth-brand">
      <span class="crest">R</span>
      <span class="t">Uniremington<small>Panel de administración</small></span>
    </div>
    <h1>Iniciar sesión</h1>
    <p class="sub">Acceso restringido al equipo de comunicaciones.</p>
    <% if (typeof error !== 'undefined' && error){ %>
      <div class="flash flash-error"><span class="msi">error</span> <span><%= error %></span></div>
    <% } %>
    <form method="post" action="/admin/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="username">Usuario</label>
        <input type="text" id="username" name="username" autocomplete="username" required autofocus value="<%= typeof username !== 'undefined' ? username : '' %>">
      </div>
      <div class="field">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
      </div>
      <button class="btn btn-primary btn-block" type="submit"><span class="msi">lock</span> Entrar</button>
    </form>
    <p class="auth-foot">Corporación Universitaria Remington · acceso monitoreado</p>
  </div>
</div>
<%- include('partials/foot-auth') %>
