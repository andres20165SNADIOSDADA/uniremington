<%- include('partials/head', { title: 'Verificación en dos pasos' }) %>
<div class="auth-screen">
  <div class="auth-card">
    <div class="auth-brand">
      <span class="crest">R</span>
      <span class="t">Uniremington<small>Panel de administración</small></span>
    </div>
    <h1>Verificación en dos pasos</h1>
    <p class="sub">Ingresa el código de 6 dígitos de tu app de autenticación.</p>
    <% if (typeof error !== 'undefined' && error){ %>
      <div class="flash flash-error"><span class="msi">error</span> <span><%= error %></span></div>
    <% } %>
    <form method="post" action="/admin/2fa/verify">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="token">Código</label>
        <input class="otp-input" type="text" id="token" name="token" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required autofocus>
      </div>
      <button class="btn btn-primary btn-block" type="submit"><span class="msi">verified_user</span> Verificar</button>
    </form>
    <p class="auth-foot">¿Perdiste el acceso a tu app de autenticación? Pide a otro administrador que reestablezca tu 2FA.</p>
  </div>
</div>
<%- include('partials/foot-auth') %>
