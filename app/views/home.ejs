  <!-- JS -->
  <script>
    // Año dinámico en el footer
    const footerYear = document.getElementById('footer-year');
    if (footerYear) footerYear.textContent = new Date().getFullYear();

    // Video thumbnail → iframe al hacer clic
    const videoThumb = document.getElementById('videoThumb');
    if (videoThumb) {
      videoThumb.addEventListener('click', () => {
        const id = videoThumb.dataset.video;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = 'Video Institucional';
        iframe.allow = 'autoplay; encrypted-media';
        iframe.allowFullscreen = true;
        videoThumb.replaceWith(iframe);
      });
    }

    // Slider del hero
    (function () {
      const hero = document.getElementById('hero');
      if (!hero) return;
      const slides = [...hero.querySelectorAll('.hero-slide')];
      const panels = [...hero.querySelectorAll('.hero-panel')];
      const dots = [...hero.querySelectorAll('.hero-dot')];
      const prevBtn = hero.querySelector('.hero-prev');
      const nextBtn = hero.querySelector('.hero-next');
      const playPauseBtn = document.getElementById('heroPlayPause');
      const progressBar = document.getElementById('heroProgressBar');
      if (slides.length < 2) return; // una sola diapositiva: nada que animar
      const DURATION = 6500;
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let current = 0;
      let playing = true;
      let timer = null;

      function goTo(index) {
        const next = (index + slides.length) % slides.length;
        if (next === current) return;
        slides[current].classList.remove('is-active');
        slides[current].setAttribute('aria-hidden', 'true');
        panels[current].classList.remove('is-active');
        dots[current].classList.remove('is-active');
        dots[current].setAttribute('aria-selected', 'false');

        current = next;

        slides[current].classList.add('is-active');
        slides[current].setAttribute('aria-hidden', 'false');
        panels[current].classList.add('is-active');
        dots[current].classList.add('is-active');
        dots[current].setAttribute('aria-selected', 'true');
        restartProgress();
      }

      function restartProgress() {
        if (!progressBar) return;
        progressBar.style.transition = 'none';
        progressBar.style.width = '0%';
        void progressBar.offsetWidth; // fuerza reflow para reiniciar la transición
        if (playing && !prefersReduced) {
          progressBar.style.transition = 'width ' + DURATION + 'ms linear';
          progressBar.style.width = '100%';
        }
      }

      function startAutoplay() {
        stopAutoplay();
        if (!playing || prefersReduced) return;
        timer = setInterval(() => goTo(current + 1), DURATION);
        restartProgress();
      }
      function stopAutoplay() {
        if (timer) { clearInterval(timer); timer = null; }
      }

      prevBtn && prevBtn.addEventListener('click', () => { goTo(current - 1); startAutoplay(); });
      nextBtn && nextBtn.addEventListener('click', () => { goTo(current + 1); startAutoplay(); });
      dots.forEach((d, i) => d.addEventListener('click', () => { goTo(i); startAutoplay(); }));

      hero.addEventListener('mouseenter', stopAutoplay);
      hero.addEventListener('mouseleave', () => { if (playing) startAutoplay(); });
      hero.addEventListener('focusin', stopAutoplay);
      hero.addEventListener('focusout', (e) => { if (playing && !hero.contains(e.relatedTarget)) startAutoplay(); });

      if (playPauseBtn) {
        playPauseBtn.addEventListener('click', () => {
          playing = !playing;
          playPauseBtn.setAttribute('aria-pressed', String(!playing));
          playPauseBtn.setAttribute('aria-label', playing ? 'Pausar reproducción automática' : 'Reanudar reproducción automática');
          playPauseBtn.querySelector('.ic-pause').hidden = !playing;
          playPauseBtn.querySelector('.ic-play').hidden = playing;
          if (playing) {
            startAutoplay();
          } else {
            stopAutoplay();
            if (progressBar) { progressBar.style.transition = 'none'; progressBar.style.width = '0%'; }
          }
        });
      }

      // Swipe táctil
      let touchStartX = null;
      hero.addEventListener('touchstart', (e) => { touchStartX = e.changedTouches[0].clientX; }, { passive: true });
      hero.addEventListener('touchend', (e) => {
        if (touchStartX === null) return;
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 40) { goTo(current + (dx < 0 ? 1 : -1)); startAutoplay(); }
        touchStartX = null;
      }, { passive: true });

      // Flechas de teclado cuando el foco está dentro del hero
      hero.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { goTo(current + 1); startAutoplay(); }
        else if (e.key === 'ArrowLeft') { goTo(current - 1); startAutoplay(); }
      });

      startAutoplay();
    })();
  </script>

  <!-- JS Actualidad Uniremingtong -->
  <script>
  const ACT_TABS = ["noticias", "eventos", "blog"];
  async function loadTab(id) {
    try {
      const res = await fetch("/api/actualidad/" + id);
      const posts = await res.json();
      if (!posts.length) return;
      const container = document.getElementById(id);
      const principal = posts[0];
      const secundarios = posts.slice(1, 5);
      container.innerHTML =
        '<div class="act-grid">' +
          '<div class="act-principal">' +
            '<a href="' + principal.url + '"><img src="' + principal.img + '" alt=""></a>' +
            '<div class="contenido"><span class="act-tag">' + principal.tag + '</span><h3>' + principal.title + '</h3></div>' +
          '</div>' +
          '<div class="act-cards">' +
            secundarios.map(function(p){ return (
              '<div class="act-card">' +
                '<a href="' + p.url + '"><img src="' + p.img + '" alt=""></a>' +
                '<div class="info"><span class="act-tag">' + p.tag + '</span><h4>' + p.title + '</h4><p>' + p.date + '</p></div>' +
              '</div>'); }).join("") +
          '</div>' +
        '</div>';
    } catch (e) { console.error("actualidad", e); }
  }
  ACT_TABS.forEach(loadTab);

  document.querySelectorAll(".act-tabs button").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".act-tabs button").forEach(b => b.classList.remove("active"));
      document.querySelectorAll(".act-tab-content").forEach(c => c.classList.remove("active"));
      btn.classList.add("active");
      document.getElementById(btn.dataset.tab).classList.add("active");
    });
  });

  // ✅ Canal oficial de Uniremington (@Uniremingtonoficial)
  const canalID = "UCS2A0DmSL-LN_ZJgFzdfivA";

  // ✅ Metodo PUBLICO sin API key: feed RSS del canal convertido a JSON con rss2json.
  //    No requiere clave de Google ni proyecto en Google Cloud.
  const maxResults = 6;

  async function cargarVideos() {
    const grid = document.getElementById('canal-grid');
    try {
      const rss = `https://www.youtube.com/feeds/videos.xml?channel_id=${canalID}`;
      const url = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(rss)}`;
      const res = await fetch(url);
      const data = await res.json();

      if (data.status !== "ok" || !data.items || !data.items.length)
        throw new Error("No se recibieron videos del canal.");

      grid.innerHTML = data.items.slice(0, maxResults).map(item => {
        // Extraer el ID del video desde el link (watch?v=, /shorts/ o youtu.be/)
        const m = item.link.match(/(?:v=|\/shorts\/|youtu\.be\/)([\w-]{11})/);
        const videoId = m ? m[1] : "";
        const title = (item.title || "").replace(/"/g, "&quot;");
        if (!videoId) return "";
        // Fachada: se muestra la miniatura; el reproductor se carga al hacer clic.
        return `
          <div class="video-card" data-id="${videoId}" role="button" tabindex="0" title="${title}" aria-label="Reproducir: ${title}">
            <img src="https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg"
                 alt="${title}" loading="lazy"
                 onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/${videoId}/hqdefault.jpg'">
            <span class="video-play" aria-hidden="true"></span>
          </div>`;
      }).join('');

      // Al hacer clic (o Enter/Espacio) en una miniatura, cargar el reproductor real
      grid.querySelectorAll('.video-card').forEach(card => {
        const reproducir = () => {
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube.com/embed/${card.dataset.id}?autoplay=1&rel=0`;
          iframe.title = card.getAttribute('title') || 'Video';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          card.replaceWith(iframe);
        };
        card.addEventListener('click', reproducir);
        card.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); reproducir(); }
        });
      });
    } catch (err) {
      console.error("Error al cargar los videos:", err);
      grid.innerHTML = '<p>No se pudieron cargar los videos en este momento. ' +
        '<a href="https://www.youtube.com/@Uniremingtonoficial/videos" target="_blank" rel="noopener">Ver el canal en YouTube</a>.</p>';
    }
  }

  cargarVideos();

  /* ============================= */
  /*    NAVBAR: MENÚ MÓVIL, DROPDOWNS Y ACORDEÓN  */
  /* ============================= */
  document.addEventListener("DOMContentLoaded", () => {
    const hamburger = document.getElementById("hamburger");
    const drawer = document.getElementById("drawer");

    // Backdrop del drawer móvil
    const backdrop = document.createElement("div");
    backdrop.classList.add("drawer-backdrop");
    document.body.appendChild(backdrop);

    function abrirMenu() {
      drawer.classList.add("open");
      drawer.setAttribute("aria-hidden", "false");
      backdrop.classList.add("active");
      hamburger.classList.add("active");
      hamburger.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    }

    function cerrarMenu() {
      drawer.classList.remove("open");
      drawer.setAttribute("aria-hidden", "true");
      backdrop.classList.remove("active");
      hamburger.classList.remove("active");
      hamburger.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    }

    hamburger.addEventListener("click", () => {
      drawer.classList.contains("open") ? cerrarMenu() : abrirMenu();
    });
    backdrop.addEventListener("click", cerrarMenu);

    // Cerrar menú al hacer clic en un enlace del drawer
    drawer.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", cerrarMenu);
    });

    // Acordeón del drawer móvil
    drawer.querySelectorAll(".m-acc").forEach(btn => {
      btn.addEventListener("click", () => {
        const panel = btn.nextElementSibling;
        const isOpen = btn.classList.contains("open");

        drawer.querySelectorAll(".m-acc").forEach(b => {
          b.classList.remove("open");
          b.nextElementSibling.classList.remove("open");
        });

        if (!isOpen) {
          btn.classList.add("open");
          panel.classList.add("open");
        }
      });
    });

    // Dropdowns del navbar de escritorio (clic, además del hover en CSS)
    document.querySelectorAll(".nav-dropdown").forEach(dd => {
      const btn = dd.querySelector(".nav-btn");
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = dd.classList.contains("open");
        document.querySelectorAll(".nav-dropdown").forEach(o => {
          o.classList.remove("open");
          o.querySelector(".nav-btn").setAttribute("aria-expanded", "false");
        });
        if (!isOpen) {
          dd.classList.add("open");
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });

    document.addEventListener("click", () => {
      document.querySelectorAll(".nav-dropdown").forEach(o => {
        o.classList.remove("open");
        o.querySelector(".nav-btn").setAttribute("aria-expanded", "false");
      });
    });
  });

  /* ════════════════════════════════════════════ */
  /*   CONTADOR TICKING + REVEAL DE TODAS LAS      */
  /*   SECCIONES                                   */
  /* ════════════════════════════════════════════ */
  (function(){
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const easeOutCubic = t => 1 - Math.pow(1 - t, 3);
    const fmtThousands = n => n.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');

    /* ────────── CONTADOR TICKING ────────── */
    function animateCounter(el){
      if (el.dataset.animated) return;
      el.dataset.animated = '1';
      // Usa el valor original guardado si existe (porque podemos haber puesto "0" para mostrar el inicio)
      const raw = (el.dataset.raw || el.textContent).trim();
      const m = raw.match(/^([+\-]?)([0-9]+(?:\.[0-9]+)*)(.*)$/);
      if (!m) return;
      const prefix = m[1] || '';
      const target = parseInt(m[2].replace(/\./g,''), 10);
      const suffix = m[3] || '';
      if (isNaN(target)) return;
      if (prefersReduced) { el.textContent = raw; return; }

      // Duración escalada según magnitud (números grandes = más tiempo para apreciarlos)
      const duration = target > 1000 ? 2800 : target > 100 ? 2400 : 1900;
      // Frecuencia de "tick": cada cuántos ms se actualiza el DOM visiblemente
      const tickInterval = target > 1000 ? 55 : target > 100 ? 70 : 85;

      el.classList.add('counting');
      const start = performance.now();
      let lastTick = 0;
      let lastDisplayed = -1;

      function frame(now){
        const t = Math.min(1, (now - start) / duration);
        const e = easeOutCubic(t);
        const cur = Math.round(target * e);

        // Solo actualiza el DOM cada tickInterval → da sensación de "ticking"
        if (now - lastTick >= tickInterval || t >= 1) {
          if (cur !== lastDisplayed) {
            lastDisplayed = cur;
            el.textContent = prefix + fmtThousands(cur) + suffix;
            // Mini-bounce visual en cada tick
            el.classList.remove('tick');
            // forzar reflow para reiniciar animación
            void el.offsetWidth;
            el.classList.add('tick');
          }
          lastTick = now;
        }

        if (t < 1) requestAnimationFrame(frame);
        else {
          el.textContent = raw;
          setTimeout(() => {
            el.classList.remove('counting');
            el.classList.remove('tick');
          }, 600);
        }
      }
      requestAnimationFrame(frame);
    }

    const counterObs = new IntersectionObserver((entries) => {
      entries.forEach(en => {
        if (en.isIntersecting) {
          animateCounter(en.target);
          counterObs.unobserve(en.target);
        }
      });
    }, { threshold: 0, rootMargin: '0px 0px -80px 0px' });

    const allCounters = document.querySelectorAll('.stat-num, .cifra-num');

    // 1) Guarda los valores originales en dataset.raw para todos
    //    Solo resetea a "0" los del HERO (visibles al cargar) — las cifras
    //    de más abajo se mantienen en su valor real y se resetean a "0"
    //    en el momento en que el usuario llega a la sección.
    allCounters.forEach(el => {
      const raw = el.textContent.trim();
      const m = raw.match(/^([+\-]?)([0-9]+(?:\.[0-9]+)*)(.*)$/);
      if (!m || prefersReduced) return;
      el.dataset.raw = raw;
      // Solo el HERO inicia visible con "0" (porque se ven al cargar)
      if (el.classList.contains('stat-num')) {
        el.textContent = (m[1] || '') + '0' + (m[3] || '');
      }
    });

    // 2) Observer principal
    allCounters.forEach(el => counterObs.observe(el));

    // 3) Helper de viewport
    function isInViewport(el, margin = 80) {
      const r = el.getBoundingClientRect();
      const h = window.innerHeight || document.documentElement.clientHeight;
      const w = window.innerWidth  || document.documentElement.clientWidth;
      return r.top < (h - margin) && r.bottom > margin && r.left < w && r.right > 0;
    }

    // 4) Fallback inicial — dispara los HERO ya visibles
    setTimeout(() => {
      document.querySelectorAll('.stat-num').forEach(el => {
        if (!el.dataset.animated && isInViewport(el, 0)) {
          animateCounter(el);
          counterObs.unobserve(el);
        }
      });
    }, 1400);

    // 5) Fallback de scroll — garantiza que las cifras disparen al llegar
    //    a la sección incluso si el IntersectionObserver no responde
    let scrollTicking = false;
    function checkOnScroll() {
      if (scrollTicking) return;
      scrollTicking = true;
      requestAnimationFrame(() => {
        document.querySelectorAll('.stat-num, .cifra-num').forEach(el => {
          if (el.dataset.animated) return;
          if (isInViewport(el, 80)) {
            animateCounter(el);
            counterObs.unobserve(el);
          }
        });
        scrollTicking = false;
      });
    }
    window.addEventListener('scroll', checkOnScroll, { passive: true });
    window.addEventListener('resize', checkOnScroll, { passive: true });

    /* ────────── REVEAL DE TODAS LAS SECCIONES ────────── */
    const revealTargets = [
      // Sección Oferta Académica
      { sel: '.oferta-container .texto-oferta',   cls: 'reveal from-left' },
      { sel: '.oferta-container .video-oferta',   cls: 'reveal from-right' },

      // Grid de 4 cards (PREGRADOS, etc.)
      { sel: '.grid-4 .card',                     cls: 'reveal with-scale', stagger: 0.12 },

      // Sección Impacto
      { sel: '.impacto-img',                      cls: 'reveal from-left' },
      { sel: '.impacto-eyebrow',                  cls: 'reveal' },
      { sel: '.impacto-text h2',                  cls: 'reveal' },
      { sel: '.impacto-text > p',                 cls: 'reveal' },
      { sel: '.impacto-cifras .cifra',            cls: 'reveal', stagger: 0.1 },

      // Sección Actualidad
      { sel: '.act-container > h2',               cls: 'reveal' },
      { sel: '.act-tabs',                         cls: 'reveal' },

      // Sección Canal YouTube
      { sel: '#canal > h2',                       cls: 'reveal' },
      { sel: '.btn-wrap',                         cls: 'reveal' },
    ];

    revealTargets.forEach(t => {
      const els = document.querySelectorAll(t.sel);
      els.forEach((el, i) => {
        t.cls.split(' ').forEach(c => el.classList.add(c));
        if (t.stagger) el.style.transitionDelay = (i * t.stagger).toFixed(2) + 's';
      });
    });

    const revealObs = new IntersectionObserver((entries) => {
      entries.forEach(en => {
        if (en.isIntersecting) {
          en.target.classList.add('visible');
          revealObs.unobserve(en.target);
        }
      });
    }, { threshold: .14, rootMargin: '0px 0px -60px 0px' });

    document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

    /* ────────── PARALLAX SUTIL DEL HERO ────────── */
    if (!prefersReduced) {
      const hero = document.querySelector('.hero');
      if (hero) {
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              const y = window.scrollY;
              if (y < window.innerHeight) {
                hero.style.backgroundPosition = `0 0, center ${20 + y * 0.04}%`;
              }
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });
      }
    }

    /* ────────── RE-DISPARAR CONTADOR AL CLICK ────────── */
    /* Permite que el usuario vea la animación de nuevo si hace click */
    document.querySelectorAll('.stat-num, .cifra-num').forEach(el => {
      el.style.cursor = 'pointer';
      el.title = 'Click para volver a contar';
      el.addEventListener('click', () => {
        delete el.dataset.animated;
        animateCounter(el);
      });
    });
  })();
</script>

