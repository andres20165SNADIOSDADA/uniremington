<!doctype html>
<html lang="es">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Corporación Universitaria Remington — Universidad en Colombia</title>
  <% var _desc = (typeof desc !== 'undefined' && desc) ? desc : 'Corporación Universitaria Remington: más de 100 años formando profesionales, con presencia en 19 sedes de Colombia. Programas de pregrado, posgrado y educación continua, presenciales y a distancia.'; %>
  <meta name="description" content="<%= _desc %>">
  <link rel="canonical" href="<%= (typeof canonical !== 'undefined' && canonical) ? canonical : 'https://www.uniremington.edu.co/' %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Corporación Universitaria Remington">
  <meta property="og:title" content="Corporación Universitaria Remington — Universidad en Colombia">
  <meta property="og:description" content="<%= _desc %>">
  <meta property="og:url" content="<%= (typeof canonical !== 'undefined' && canonical) ? canonical : 'https://www.uniremington.edu.co/' %>">
  <meta name="twitter:card" content="summary">
  <% if (typeof jsonld !== 'undefined' && jsonld){ %><script type="application/ld+json"><%- JSON.stringify(jsonld) %></script><% } %>
  <!-- Preload de la fuente de iconos: sin esto los iconos del megamenú aparecen como
       texto hasta que un elemento visible la dispara (en la home no hay ninguno). -->
  <link rel="preload" href="/fonts/ms-sharp.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/fonts.css">
  <!-- Navbar + megamenú + drawer: fuente única de verdad (compartida con el resto del sitio) -->
  <link rel="stylesheet" href="/css/menu.css">
  <style>
    .skip-link{position:fixed;top:-60px;left:12px;z-index:2000;background:#00457c;color:#fff;
      padding:10px 18px;border-radius:0 0 10px 10px;font-weight:700;text-decoration:none;
      box-shadow:0 6px 18px rgba(0,0,0,.25);transition:top .18s ease}
    .skip-link:focus{top:0;outline:3px solid #fff;outline-offset:-3px}
    :root {
      --blue: #00457c;
      --blue-soft: #0f6f9e;
      --light: #eef6fb;
      --accent: #e30613;
      --accent-dark: #b0050f;
      --dark: #0b2b3a;
      --muted: #6b7a85;
      --container: 1100px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    body {
      font-family: 'PT Sans', sans-serif;
      color: var(--dark);
      background: #fff;
    }

    a {
      color: inherit;
      text-decoration: none
    }

    /* Layout */
    .wrap {
      max-width: var(--container);
      margin: 0 auto;
      padding: 28px
    }

    header {
      position: relative;
      z-index: 50
    }

    .btn {
      background-color: white;
      color: #e30613;
      padding: 8px 12px;
      border-radius: 8px;
      font-weight: 600
    }


    /* Hero como banner */
    .hero {
      position: relative;
      min-height: 380px;
      display: flex;
      align-items: center;
      color: white;
      overflow: hidden;
      background: #012a4d; /* color de respaldo mientras cargan las imágenes */
    }

    /* ─── Slider: capas de fondo con crossfade + Ken Burns ─── */
    .hero-slides {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
    }
    .hero-slide {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center 22%;
      opacity: 0;
      transition: opacity 1.1s ease;
    }
    .hero-slide.is-active {
      opacity: 1;
      animation: heroKenBurns 9s ease-out forwards;
    }
    @keyframes heroKenBurns {
      from { transform: scale(1); }
      to   { transform: scale(1.07); }
    }
    /* Diapositiva de marca sin foto: gradiente propio (no un hueco vacío) */
    .hero-slide[data-noimg] {
      background:
        radial-gradient(circle at 14% 18%, rgba(255, 255, 255, 0.10) 0%, transparent 45%),
        radial-gradient(circle at 86% 78%, rgba(227, 7, 21, 0.28) 0%, transparent 50%),
        linear-gradient(135deg, #012a4d 0%, #014f86 55%, #0077b6 100%);
    }
    /* Velo de marca constante encima de cualquier imagen/gradiente de fondo */
    .hero-scrim {
      position: absolute;
      inset: 0;
      z-index: 1;
      background: linear-gradient(120deg, rgba(0, 69, 124, 0.85) 0%, rgba(0, 90, 158, 0.62) 55%, rgba(0, 30, 56, 0.55) 100%);
      pointer-events: none;
    }

    .hero::before {
      content: "";
      position: absolute;
      top: -120px;
      right: -120px;
      width: 480px;
      height: 480px;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.08) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
      z-index: 2;
    }

    .hero::after {
      content: "";
      position: absolute;
      bottom: -160px;
      left: -80px;
      width: 360px;
      height: 360px;
      background: radial-gradient(circle, rgba(227, 7, 21, 0.18) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
      z-index: 2;
    }

    .hero-inner {
      position: relative;
      z-index: 3;
      width: 100%;
      max-width: var(--container);
      margin: 0 auto;
      padding: 28px 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 24px;
      min-height: 380px;
    }

    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 620px;
      display: grid; /* los paneles se apilan en la misma celda para el crossfade */
    }

    /* Cada diapositiva de texto ocupa la misma celda (crossfade sin saltos de layout) */
    .hero-panel {
      grid-area: 1 / 1;
      opacity: 0;
      visibility: hidden;
      transform: translateY(14px);
      pointer-events: none;
      transition: opacity .6s ease, transform .6s ease, visibility 0s linear .6s;
    }
    .hero-panel.is-active {
      opacity: 1;
      visibility: visible;
      transform: none;
      pointer-events: auto;
      transition: opacity .6s ease .15s, transform .6s ease .15s, visibility 0s linear;
    }

    .hero-badge {
      display: inline-block;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #fff;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.3px;
      margin-bottom: 18px;
      backdrop-filter: blur(4px);
    }

    .hero h1 {
      font-size: 38px;
      line-height: 1.15;
      margin-bottom: 14px;
      font-weight: 800;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    }

    .hero h1 .accent {
      color: #ff6b6b;
      display: block;
    }

    .hero p {
      margin-bottom: 26px;
      font-size: 17px;
      line-height: 1.5;
      color: #e8eef5;
      max-width: 520px;
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 22px;
      flex-wrap: wrap;
    }

    .hero .cta-hero {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--accent);
      color: #fff;
      padding: 12px 26px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.95rem;
      box-shadow: 0 4px 12px rgba(227, 7, 21, 0.35);
      transition: background 0.3s ease, transform 0.2s ease;
    }

    .hero .cta-hero:hover {
      background: var(--accent-dark);
      transform: translateY(-2px);
    }

    .hero .video-link {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: #fff;
      font-weight: 600;
      font-size: 0.95rem;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      font-family: inherit;
    }

    .hero .video-link .play {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.18);
      border: 1px solid rgba(255, 255, 255, 0.4);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
    }

    .hero-stats {
      display: flex;
      gap: 32px;
      flex-wrap: wrap;
      padding-top: 14px;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
    }

    .hero-stats > div {
      min-width: 84px;
    }

    .hero-stats .stat-num {
      font-size: 1.55rem;
      font-weight: 800;
      color: #fff;
      line-height: 1;
    }

    .hero-stats .stat-label {
      font-size: 0.8rem;
      color: #cfd9e3;
      margin-top: 4px;
      text-transform: capitalize;
    }

    /* ─── Controles del slider (flechas, dots, pausa) ─── */
    /* Hijo de .hero-inner: en escritorio se ancla abajo-derecha (position:absolute lo saca
       del flujo flex, así que no altera el "space-between" entre .hero-content y .hero-stats).
       En móvil vuelve al flujo normal (ver media query 768px). */
    .hero-controls {
      position: absolute;
      z-index: 4;
      right: 0;
      bottom: 4px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .hero-arrow, .hero-playpause {
      width: 36px;
      height: 36px;
      flex: none;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.28);
      color: #fff;
      display: grid;
      place-items: center;
      cursor: pointer;
      backdrop-filter: blur(6px);
      transition: background .2s ease, transform .2s ease, border-color .2s ease;
    }
    .hero-arrow svg, .hero-playpause svg { width: 16px; height: 16px; }
    .hero-arrow:hover, .hero-playpause:hover {
      background: rgba(255, 255, 255, 0.28);
      border-color: rgba(255, 255, 255, 0.5);
      transform: translateY(-1px);
    }
    .hero-dots {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .hero-dot {
      width: 8px;
      height: 8px;
      padding: 0;
      border: none;
      border-radius: 5px;
      background: rgba(255, 255, 255, 0.4);
      cursor: pointer;
      transition: background .25s ease, width .25s ease;
    }
    .hero-dot:hover { background: rgba(255, 255, 255, 0.7); }
    .hero-dot.is-active { width: 22px; background: #fff; }

    /* Barra de avance automático (indicador sutil en el borde inferior) */
    .hero-progress {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      z-index: 4;
      height: 3px;
      background: rgba(255, 255, 255, 0.14);
    }
    .hero-progress-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--accent), #ff8a80);
    }

    /* Sección Educación que transforma realidades */
    .impacto {
      padding: 60px 0;
    }

    .impacto-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      align-items: stretch;
    }

    .impacto-img {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 50px rgba(0, 68, 123, 0.18);
    }

    .impacto-img::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, rgba(0, 68, 123, 0.0) 40%, rgba(0, 68, 123, 0.35) 100%);
      pointer-events: none;
    }

    .impacto-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      min-height: 420px;
      transition: transform 0.6s ease;
    }

    .impacto-img:hover img {
      transform: scale(1.04);
    }

    .impacto-eyebrow {
      color: var(--accent);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 12px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .impacto-eyebrow::before {
      content: "";
      width: 28px;
      height: 2px;
      background: var(--accent);
      display: inline-block;
    }

    .impacto-text h2 {
      font-size: 2.4rem;
      color: var(--blue);
      font-weight: 800;
      line-height: 1.15;
      margin-bottom: 18px;
    }

    .impacto-text > p {
      color: #4a5560;
      line-height: 1.65;
      margin-bottom: 32px;
      font-size: 1.02rem;
    }

    .impacto-cifras {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .impacto-cifras .cifra {
      position: relative;
      padding: 22px 20px 20px;
      background: linear-gradient(135deg, #ffffff 0%, #f5fafd 100%);
      border-radius: 14px;
      border: 1px solid #e6eef5;
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
      overflow: hidden;
    }

    .impacto-cifras .cifra::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: linear-gradient(180deg, var(--blue), var(--accent));
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .impacto-cifras .cifra:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(0, 68, 123, 0.12);
      border-color: transparent;
    }

    .impacto-cifras .cifra:hover::before {
      opacity: 1;
    }

    .impacto-cifras .cifra-num {
      font-size: 2.2rem;
      font-weight: 800;
      background: linear-gradient(135deg, var(--blue) 0%, var(--blue-soft) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1;
      letter-spacing: -0.5px;
    }

    .impacto-cifras .cifra-titulo {
      font-weight: 700;
      color: var(--dark);
      margin: 8px 0 4px;
      font-size: 0.95rem;
    }

    .impacto-cifras .cifra-desc {
      font-size: 0.82rem;
      color: var(--muted);
      line-height: 1.45;
    }

    .impacto-cifras .cifra-destacada {
      grid-column: 1 / -1;
      background: linear-gradient(135deg, var(--blue) 0%, var(--blue-soft) 100%);
      border-color: transparent;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 22px;
    }

    .impacto-cifras .cifra-destacada::before {
      background: linear-gradient(180deg, #fff, var(--accent));
      opacity: 1;
    }

    .impacto-cifras .cifra-destacada .cifra-num {
      background: none;
      -webkit-text-fill-color: #fff;
      color: #fff;
      font-size: 2.6rem;
      flex-shrink: 0;
    }

    .impacto-cifras .cifra-destacada .cifra-titulo {
      color: #fff;
    }

    .impacto-cifras .cifra-destacada .cifra-desc {
      color: rgba(255, 255, 255, 0.85);
    }

    .cta-row {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap
    }

    /* Secciones */
    section {
      padding: 36px 0
    }

    /* Nueva sección de Oferta Académica con video */
    .oferta-container {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 40px;
      padding: 50px 20px;
    }

    .texto-oferta {
      flex: 1 1 400px;
      max-width: 500px;
    }

    .texto-oferta h2 {
      font-size: 40px;
      margin-bottom: 20px;
      font-weight: 800;
    }

    .texto-oferta p {
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 20px;
      color: var(--muted);
    }

    .texto-oferta .btn {
      display: inline-block;
      background: var(--accent);
      color: #fff;
      padding: 10px 22px;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
      transition: background 0.3s;
    }

    .texto-oferta .btn:hover {
      background: var(--accent-dark);
    }

    .video-oferta {
      flex: 1 1 400px;
      max-width: 560px;
    }

    .video-oferta iframe {
      width: 100%;
      height: 315px;
      border-radius: 12px;
      border: none;
    }

    .video-thumb {
      position: relative;
      width: 100%;
      height: 315px;
      border-radius: 12px;
      overflow: hidden;
      cursor: pointer;
      background: #000;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    .video-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease, opacity 0.3s ease;
    }

    .video-thumb:hover img {
      transform: scale(1.04);
      opacity: 0.9;
    }

    .video-thumb::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.45) 100%);
      pointer-events: none;
    }

    .video-thumb .play-btn {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 78px;
      height: 78px;
      border-radius: 50%;
      background: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(227, 7, 21, 0.45);
      z-index: 2;
      transition: transform 0.3s ease, background 0.3s ease;
    }

    .video-thumb:hover .play-btn {
      transform: translate(-50%, -50%) scale(1.1);
      background: var(--accent-dark);
    }

    .video-thumb .play-btn::before {
      content: "";
      width: 0;
      height: 0;
      border-left: 22px solid #fff;
      border-top: 14px solid transparent;
      border-bottom: 14px solid transparent;
      margin-left: 6px;
    }

    .grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }

    .card {
      background: #fff;
      overflow: hidden;
      box-shadow: 0 1px 2px rgba(3, 58, 104, .05), 0 12px 26px -12px rgba(3, 58, 104, .16);
    }

    .card img {
      display: block;
      width: 100%;
      height: 360px;
      object-fit: cover;
    }

    .card a.caption {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      min-height: 70px;
      font-weight: 700;
      color: white;
      transition: 0.3s ease
    }

    .card a.caption:hover {
      opacity: 0.9;
      cursor: pointer
    }

    .caption.carreras {
      background-color: var(--blue);
    }

    .caption.tecnologias {
      background-color: var(--blue-soft);
    }

    .caption.especializaciones {
      background-color: #2c7da0;
    }

    .caption.extension {
      background-color: var(--accent);
    }

    .caption.maestrias {
      background-color: #013a63;
    }

    /* La tarjeta de Maestrías usa una foto real (graduación) a la que aplicamos un duotono
       azul por CSS para igualar la identidad de las demás (que ya vienen tintadas). */
    .card-tinted {
      position: relative;
      display: block;
      background: #1c62a6;
    }
    .card-tinted img {
      filter: grayscale(1) contrast(1.05) brightness(1.04);
      mix-blend-mode: luminosity;
    }
    .card-tinted::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(30, 110, 190, .28), rgba(1, 40, 75, .40));
      pointer-events: none;
    }

    /* Redondeo del footer segun la POSICION (no el color): así queda bien con cualquier orden */
    .grid-4 .card:first-child .caption { border-bottom-left-radius: 20px; }
    .grid-4 .card:last-child .caption { border-bottom-right-radius: 20px; }

    /* ═══════════════ FOOTER ═══════════════ */
    footer {
      background: linear-gradient(180deg, #0b2b3a 0%, #071c27 100%);
      color: #fff;
      margin-top: 30px;
      position: relative;
      overflow: hidden;
    }

    footer::before {
      content: "";
      position: absolute;
      top: -140px;
      right: -100px;
      width: 380px;
      height: 380px;
      background: radial-gradient(circle, rgba(0, 119, 182, 0.18) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .footer-top {
      max-width: var(--container);
      margin: 0 auto;
      padding: 56px 28px 32px;
      position: relative;
      z-index: 1;
    }

    .foot-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
      gap: 36px;
    }

    .foot-brand img {
      height: 46px;
      margin-bottom: 14px;
    }

    .foot-brand p {
      color: rgba(255, 255, 255, 0.65);
      font-size: 0.9rem;
      line-height: 1.6;
      max-width: 320px;
      margin-bottom: 18px;
    }

    .foot-social {
      display: flex;
      gap: 10px;
    }

    .foot-social a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      transition: background 0.25s ease, transform 0.25s ease;
    }

    .foot-social a:hover {
      background: var(--accent);
      transform: translateY(-3px);
    }

    .foot-social svg {
      width: 18px;
      height: 18px;
    }

    .foot-col h5 {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 16px;
      letter-spacing: 0.02em;
    }

    .foot-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .foot-col a {
      color: rgba(255, 255, 255, 0.65);
      font-size: 0.88rem;
      transition: color 0.2s ease, padding-left 0.2s ease;
    }

    .foot-col a:hover {
      color: #fff;
      padding-left: 4px;
    }

    .foot-col address {
      font-style: normal;
      color: rgba(255, 255, 255, 0.65);
      font-size: 0.88rem;
      line-height: 1.7;
    }

    .foot-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding: 18px 28px;
      max-width: var(--container);
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
